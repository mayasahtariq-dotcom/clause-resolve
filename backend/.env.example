# ---- ClauseLens backend configuration (copy to .env; never commit real keys) ----
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173 # comma-separated; explicit origins only in production

# Persistence
PERSISTENCE_PROVIDER=sqlalchemy
DATABASE_URL=postgresql+psycopg://clauselens:clauselens@localhost:5432/clauselens

# Web research (tinyfish | fixture[demo, not allowed in production])
WEB_RESEARCH_PROVIDER=tinyfish
TINYFISH_API_KEY=your-tinyfish-api-key-here
RESEARCH_MAX_PAGES_PER_VENDOR=6

# LLM layer (openrouter | ollama | openai_compatible | fixture[demo])
# OpenRouter analyses the text TinyFish retrieved; it never browses websites itself.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here      # https://openrouter.ai/keys (backend only, never commit)
OPENROUTER_MODEL=google/gemini-2.5-flash             # any model id from https://openrouter.ai/models
OPENROUTER_RESPONSE_FORMAT=json_object               # json_object | json_schema (structured-output models) | none
# OPENROUTER_APP_URL=https://your-site.example       # optional attribution header
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4

# Risky-clause scan (runs on TinyFish pages with the LLM above)
RISK_ANALYSIS_ENABLED=true
RISK_CHUNK_CHARS=12000             # long pages are split into sections of this size
RISK_MAX_CHUNKS_PER_VENDOR=8       # cost cap per vendor; the report says when a document was truncated

# Alternative LLM: Ollama Cloud (set LLM_PROVIDER=ollama)
# LLM_BASE_URL=https://ollama.com
# LLM_API_KEY=your-ollama-api-key-here
# LLM_MODEL=gpt-oss:120b

# Background jobs (celery | inline[dev only] | sync[tests])
JOB_QUEUE_PROVIDER=celery
REDIS_URL=redis://localhost:6379/0

# Optional raw-payload storage (none | local)
STORAGE_PROVIDER=none
